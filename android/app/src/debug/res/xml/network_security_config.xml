<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file lives under src/debug/, so the manifest merger
  applies it to debuggable builds and to nothing else — a release APK never
  sees it and keeps Android's default, which forbids cleartext outright.

  It exists because the development API runs on the machine's LAN address over
  plain HTTP: `localhost` on a handset is the handset, and putting a
  certificate on a laptop for every developer is not a trade worth making for
  a leaderboard. The permission is scoped to private address ranges rather
  than opened globally, so a debug build still cannot be pointed at an
  arbitrary cleartext host on the internet.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- The three private IPv4 ranges, plus the emulator's host alias. -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.0.141</domain>
    </domain-config>
</network-security-config>
