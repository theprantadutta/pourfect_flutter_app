<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MUST match NotificationService._channelId. Two names for one channel
         is how an app ends up with two rows in the player's notification
         settings, only one of which does anything. -->
    <string name="default_notification_channel_id">pourfect.reminders</string>

    <!-- Toy.tomato (0xFFFF5A36) verbatim — the brand color the app uses
         for the primary action and "this one is current". Android tints the white silhouette with it.
         Copied from lib/ui/theme/toy.dart; if that moves, move this. -->
    <color name="notification_accent">#FFFF5A36</color>
</resources>
