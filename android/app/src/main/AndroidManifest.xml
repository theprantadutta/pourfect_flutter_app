<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ will not deliver a single notification without this, and
         it fails SILENTLY: no exception, nothing in the log, the player simply
         never hears from us. firebase_messaging declares it too and the merge
         would pull it in, but relying on a dependency's manifest for a
         permission this app genuinely needs means a plugin swap can remove it
         without anybody noticing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Pourfect"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- AdMob APP id. Note the TILDE: an app id uses '~', an ad UNIT id
             uses '/'. Putting a unit id here crashes on launch with
             "Invalid application ID"; putting an app id in Dart silently
             never loads an ad, which is far harder to diagnose.

             The LIVE id, in every build mode. Google's test AD UNITS serve
             under any app id, so debug builds still get test ads (see
             services/ads/ad_ids.dart) and there is no second value here to
             keep in step. Source: generated/ad_config.md. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9242904787767394~3712054804"/>

        <!-- The status-bar icon for the evening daily reminder.

             Android IGNORES the color in a notification icon: it keeps the
             alpha and tints the rest. Pointing this at the launcher icon is
             the usual mistake and renders a featureless grey square, because
             every opaque pixel becomes the tint color. ic_notification is a
             white-on-transparent silhouette of one tube for that reason. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- The channel FCM posts to when a message arrives with the app dead
             or backgrounded, which is most of them.

             Without this, Android invents a fallback channel: default
             importance, a name the player has never seen, and no relationship
             to the one NotificationService creates. They would then see TWO
             Pourfect channels in system settings and turning off the wrong one
             would appear to do nothing. The value must match
             NotificationService._channelId exactly. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- The tint applied to that white silhouette. Our accent, so the icon
             reads as ours in a crowded shade rather than as system grey. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
