  "settingsFaqHowToPlayQ": "How do I play?",
  "@settingsFaqHowToPlayQ": {"description": "FAQ question."},
  "settingsFaqHowToPlayA": "Tap a tube to pick up its top balls, then tap another tube to pour them in. Balls only land on the same color or in an empty tube. Sort every tube to one color and the level is done. Settings → How to play replays the guided first level.",
  "@settingsFaqHowToPlayA": {"description": "FAQ answer. 'Settings → How to play' must match the Settings screen and the How to play row titles."},
  "settingsFaqStarsQ": "What do the stars mean?",
  "@settingsFaqStarsQ": {"description": "FAQ question."},
  "settingsFaqStarsA": "Stars count moves, nothing else. Finish in par or fewer for three stars, within one and a half times par for two, and any finish earns one. Par is the fewest moves the level can be solved in.",
  "@settingsFaqStarsA": {"description": "FAQ answer. The thresholds (par, 1.5x par) are game rules; keep them exact."},
  "settingsFaqClockQ": "Does the clock cost me stars?",
  "@settingsFaqClockQ": {"description": "FAQ question."},
  "settingsFaqClockA": "Never. Time only changes your points. Beat the time par for bonus points, or take as long as you like and keep every star.",
  "@settingsFaqClockA": {"description": "FAQ answer."},
  "settingsFaqSolvableQ": "Is every level solvable?",
  "@settingsFaqSolvableQ": {"description": "FAQ question."},
  "settingsFaqSolvableA": "Yes. Every board was solved before it shipped, and par comes from that solution, so it is always reachable.",
  "@settingsFaqSolvableA": {"description": "FAQ answer."},
  "settingsFaqDailyQ": "What is the Daily Pour?",
  "@settingsFaqDailyQ": {"description": "FAQ question. 'Daily Pour' is the daily challenge's name."},
  "settingsFaqDailyA": "A new board every day, with its own leaderboard. It needs an internet connection. The campaign levels do not.",
  "@settingsFaqDailyA": {"description": "FAQ answer."},
  "settingsFaqUndoQ": "Is undo limited?",
  "@settingsFaqUndoQ": {"description": "FAQ question."},
  "settingsFaqUndoA": "No. Undo is free and unlimited, on every level.",
  "@settingsFaqUndoA": {"description": "FAQ answer."},
  "settingsFaqHintsQ": "How do hints work?",
  "@settingsFaqHintsQ": {"description": "FAQ question."},
  "settingsFaqHintsA": "{count, plural, =1{Your first hint is free. After that, a short video earns one. If a hint cannot be found, the video still counts toward your next one.} other{Your first {count} hints are free. After that, a short video earns one. If a hint cannot be found, the video still counts toward your next one.}}",
  "@settingsFaqHintsA": {
    "description": "FAQ answer. {count} is the number of free hints the game gives.",
    "placeholders": {"count": {"type": "int"}}
  },
  "settingsFaqTubeQ": "What is the + Tube button?",
  "@settingsFaqTubeQ": {"description": "FAQ question. '+ Tube' is the in-game button's label."},
  "settingsFaqTubeA": "When your moves reach par, or a hint shows there is no way to finish, you can watch a video for an extra empty tube, up to two per attempt. Undo will not take it away. A level finished with an extra tube earns up to two stars.",
  "@settingsFaqTubeA": {"description": "FAQ answer."},
  "settingsFaqHardQ": "What are HARD levels?",
  "@settingsFaqHardQ": {"description": "FAQ question. 'HARD' is the badge's text on the level."},
  "settingsFaqHardA": "The toughest level in every ten wears a red HARD badge. It plays like any other level, and it is worth one and a half times the points.",
  "@settingsFaqHardA": {"description": "FAQ answer. 'HARD' must match the badge's text."},
  "settingsFaqChestsQ": "What are star chests?",
  "@settingsFaqChestsQ": {"description": "FAQ question."},
  "settingsFaqChestsA": "Every 30 stars opens a chest on your Journey: two hints and an extra tube, saved for when you need them. Every third chest also unlocks a ball skin.",
  "@settingsFaqChestsA": {"description": "FAQ answer. 'Journey' is the level map screen's name."},
  "settingsFaqFreezeQ": "What is a streak freeze?",
  "@settingsFaqFreezeQ": {"description": "FAQ question."},
  "settingsFaqFreezeA": "Miss a day of the Daily Pour and a freeze covers it, so your streak carries on. You get one free every Monday, can earn one a day with a video, and can hold two.",
  "@settingsFaqFreezeA": {"description": "FAQ answer."},
  "settingsFaqAccountQ": "Do I need an account?",
  "@settingsFaqAccountQ": {"description": "FAQ question."},
  "settingsFaqAccountA": "No. You play as a guest and your progress is saved on this phone. Signing in keeps your stars when you move to a new phone.",
  "@settingsFaqAccountA": {"description": "FAQ answer."},
  "settingsFaqOfflineQ": "Can I play offline?",
  "@settingsFaqOfflineQ": {"description": "FAQ question."},
  "settingsFaqOfflineA": "Yes, the whole campaign. The Daily Pour and leaderboards need a connection, and your progress syncs when you are back online.",
  "@settingsFaqOfflineA": {"description": "FAQ answer."},
  "settingsFaqNameQ": "How do I change my leaderboard name?",
  "@settingsFaqNameQ": {"description": "FAQ question."},
  "settingsFaqNameA": "Settings → Change your name. You can also hide yourself from the boards there; your stars still count.",
  "@settingsFaqNameA": {"description": "FAQ answer. 'Settings → Change your name' must match the screen and row titles."},
  "settingsFaqRemoveAdsQ": "What does Remove ads do?",
  "@settingsFaqRemoveAdsQ": {"description": "FAQ question. 'Remove ads' is the purchase's name."},
  "settingsFaqRemoveAdsA": "It turns off the ads between levels. Hint and tube videos stay, because you only ever see one when you ask for it.",
  "@settingsFaqRemoveAdsA": {"description": "FAQ answer."},
  "settingsFaqReinstallQ": "I reinstalled. Where did Remove ads go?",
  "@settingsFaqReinstallQ": {"description": "FAQ question."},
  "settingsFaqReinstallA": "It belongs to the store account you bought it with and usually comes back on its own. If not, tap Settings → Restore purchases.",
  "@settingsFaqReinstallA": {"description": "FAQ answer. 'Settings → Restore purchases' must match the screen and row titles."},
  "settingsFaqMusicQ": "Will the game stop my music?",
  "@settingsFaqMusicQ": {"description": "FAQ question."},
  "settingsFaqMusicA": "No. Pourfect plays its sounds alongside your music or podcast. Sound and haptics can be turned off in Settings.",
  "@settingsFaqMusicA": {"description": "FAQ answer."},

